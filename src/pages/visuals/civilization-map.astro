    function updateSub() {
      ticking = false;
      if (!current) { return; }
      var sub = current.querySelector('.subnav');
      if (!sub) { return; }
      var secs = current.querySelectorAll('.viewbody > section[id]');
      if (!secs.length) { return; }
      var cur = secs[0].id;
      for (var i = 0; i < secs.length; i++) {
        if (secs[i].getBoundingClientRect().top <= 150) { cur = secs[i].id; }
