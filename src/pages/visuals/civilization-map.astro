    /* 欧洲：深蓝 / 酒红 / 旧金 —— 浅色 */
    --eu-1: #3E6C99; --eu-2: #A34A4A; --eu-3: #B08838;
    /* 亚洲：朱砂 / 黛青 / 玉石绿 —— 浅色 */
    --as-1: #C15F3C; --as-2: #4A7386; --as-3: #5B8468;
    /* 四类因素 —— 浅色 */
    --f-inst: #4E7191; --f-idea: #96762F; --f-tech: #5C7A50; --f-flow: #9A5560;

    --g: 16px;
