        current = view;
        markNav(view);
        primeReveals(view);
      }
      if (target && target !== view) { target.scrollIntoView(); }
      else { topOfPage(); }
      if (switched && push) {
        var head = view.querySelector('h1, h2');
        if (head) {
          try { head.setAttribute('tabindex', '-1'); head.focus({ preventScroll: true }); } catch (e) {}
        }
      }
      if (push) {
        var hash = '#' + ((target && target.id) || view.id);
        try { if (location.hash !== hash) { history.pushState(null, '', hash); } } catch (e) {}
      }
      updateSub();
      return true;
    }

    document.addEventListener('click', function (ev) {
      if (ev.defaultPrevented || ev.button !== 0) { return; }
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) { return; }
      var a = ev.target;
      while (a && a.nodeType === 1 && a.tagName !== 'A') { a = a.parentNode; }
      if (!a || a.nodeType !== 1 || a.tagName !== 'A') { return; }
      if (!page.contains(a)) { return; }
      var href = a.getAttribute('href');
      if (!href || href.charAt(0) !== '#' || href.length < 2) { return; }
      var r = resolve(href);
      if (!r) { return; }
      ev.preventDefault();
      activate(r.view, r.target, true);
