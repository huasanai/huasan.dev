  /* 站内页不再固定 subnav（分区条已常驻），避免两条粘性栏叠加 */
  .visual-page .subnav { position: static; background: transparent; backdrop-filter: none; }

  /* 站内页去掉首屏网格底纹：站点本身是干净的，这层纹理会变成一块灰斑 */
