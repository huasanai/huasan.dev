  /* ======== 以下为原信息图样式（令牌已接到 global.css） ======== */

/* ============================================================
   欧洲与亚洲文明发展脉络及关键转折点
   单文件静态页 / 无外部依赖 / 离线可用
   设计语言：纸本图鉴 + 测绘刻度尺
   ============================================================ */

*,*::before,*::after{box-sizing:border-box}

img,svg{max-width:100%}


/* —— 排版基元 —— */
h1,h2,h3,h4,h5{font-weight:600;line-height:1.3;margin:0;letter-spacing:.005em}

p{margin:0 0 .9em}

p:last-child{margin-bottom:0}

a{color:var(--eu-1);text-underline-offset:.22em;text-decoration-thickness:.5px;text-decoration-color:var(--rule-2)}

a:hover{text-decoration-color:currentColor}

:focus-visible{outline:2px solid var(--v-accent);outline-offset:3px;border-radius:1px}

.mono{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:.02em}

.sans{font-family:var(--sans)}

.sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}


.wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(18px,5vw,56px)}

.prose{max-width:66ch}

main{padding-bottom:90px}


/* ============================================================
   章节
   ============================================================ */
/* 分区视图：无 JS 时全部展开，退化为一张长滚动页 */
.view{display:block}

.visual-page.is-routed .view{display:none}

.visual-page.is-routed .view.is-active{display:block}


.viewbody>section[id]{scroll-margin-top:70px;padding:clamp(40px,6vw,72px) 0 8px}

.viewbody>section+section{border-top:1px solid var(--rule)}

.viewbody>section[id]:first-child{padding-top:clamp(26px,3.4vw,40px)}


.eyebrow{
  font-family:var(--sans);font-size:11.5px;letter-spacing:.2em;color:var(--ink-3);
  margin:0 0 14px;display:flex;align-items:center;gap:10px
}

.eyebrow::before{content:"";width:22px;height:1px;background:var(--v-accent);flex:none}

.eyebrow .num{font-family:var(--mono);color:var(--v-accent);letter-spacing:.08em}


h2.h{font-size:clamp(26px,4.2vw,40px);letter-spacing:0;margin:0 0 .5em}

h3.h{font-size:clamp(19px,2.4vw,24px);margin:0 0 .55em}

.lede{font-size:clamp(16.5px,1.6vw,18.5px);color:var(--ink-2);max-width:60ch}


/* ============================================================
   首屏
   ============================================================ */
.hero{padding:clamp(52px,9vw,110px) 0 clamp(40px,6vw,70px);position:relative;overflow:hidden}

.hero::before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.42;
  background-image:linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px);
  background-size:100% 64px,64px 100%;
  -webkit-mask-image:radial-gradient(78% 62% at 88% 8%,#000 0%,transparent 72%);
  mask-image:radial-gradient(78% 62% at 88% 8%,#000 0%,transparent 72%);
}

.hero__kicker{font-family:var(--sans);font-size:12px;letter-spacing:.24em;color:var(--ink-3);margin:0 0 22px}

.hero h1{font-size:clamp(34px,7.4vw,72px);line-height:1.12;letter-spacing:0;margin:0 0 .3em;max-width:15ch}

.hero h1 em{font-style:normal;color:var(--eu-1)}

.hero h1 i{font-style:normal;color:var(--as-1)}

.hero__sub{font-size:clamp(17px,2.2vw,22px);color:var(--ink-2);max-width:44ch;margin:0 0 28px;line-height:1.6}

.hero__meta{display:flex;flex-wrap:wrap;gap:8px 26px;font-family:var(--mono);font-size:12px;color:var(--ink-3);margin:0 0 34px}


.caution{
  border-left:2px solid var(--eu-3);background:linear-gradient(90deg,color-mix(in srgb,var(--eu-3) 9%,transparent),transparent 70%);
  padding:16px 20px;max-width:60ch;margin:0 0 34px
}

.caution strong{color:var(--eu-3);font-weight:600}

.caution p{font-size:16px;color:var(--ink-2)}


.gates{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));max-width:760px}

.gate{
  display:block;text-decoration:none;color:inherit;background:var(--panel);
  border:1px solid var(--rule);border-top:3px solid var(--gc);padding:20px 22px 22px;
  transition:transform .22s cubic-bezier(.2,.7,.2,1),box-shadow .22s ease,border-color .22s ease;position:relative
}

.gate:hover{transform:translateY(-3px);box-shadow:var(--shadow-lift);border-color:var(--rule-2);border-top-color:var(--gc)}
@media (prefers-reduced-motion: reduce){
.gate,.gate:hover{transition:none;transform:none}
}

.gate .g-n{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--gc)}

.gate h3{font-size:22px;margin:6px 0 8px}

.gate p{font-size:14.5px;color:var(--ink-3);line-height:1.7;font-family:var(--sans)}

.gate .g-go{font-family:var(--sans);font-size:12.5px;color:var(--gc);letter-spacing:.06em;margin-top:12px;display:block}

.gate--eu{--gc:var(--eu-1)}

.gate--as{--gc:var(--as-1)}


/* ============================================================
   图例
   ============================================================ */
.legend-grid{display:grid;gap:var(--g);grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));margin:26px 0 0}

.lg{border:1px solid var(--rule);background:var(--panel);padding:15px 17px}

.lg h4{font-family:var(--sans);font-size:14.5px;margin:0 0 6px;display:flex;align-items:center;gap:9px}

.lg p{font-size:14px;color:var(--ink-3);font-family:var(--sans);line-height:1.65;margin:0}


/* 四类因素的形状标记 */
.mk{width:12px;height:12px;flex:none;display:inline-block;background:var(--f)}

.mk--inst{--f:var(--f-inst)}

.mk--idea{--f:var(--f-idea);background:none;border:2px solid var(--f);border-radius:50%}

.mk--tech{--f:var(--f-tech);clip-path:polygon(50% 0,100% 100%,0 100%)}

.mk--flow{--f:var(--f-flow);background:none;border-top:3px solid var(--f);border-bottom:3px solid var(--f);height:11px}


.tag{
  display:inline-flex;align-items:center;gap:6px;font-family:var(--sans);font-size:11.5px;
  color:var(--f);letter-spacing:.04em;white-space:nowrap
}

.tag .mk{width:9px;height:9px}

.tag--idea .mk{border-width:1.5px}

.tag--flow .mk{border-top-width:2px;border-bottom-width:2px;height:8px}

.tags{display:flex;flex-wrap:wrap;gap:5px 14px;margin:8px 0 0}


.sym{display:grid;gap:10px;margin:22px 0 0;max-width:66ch}

.sym div{display:grid;grid-template-columns:8.5rem minmax(0,1fr);gap:14px;font-size:15px;align-items:baseline;font-family:var(--sans);line-height:1.7}

.sym dt,.sym b{font-family:var(--mono);font-size:13px;color:var(--ink);font-weight:400}

.sym span{color:var(--ink-3)}
@media (max-width:560px){
.sym div{grid-template-columns:1fr;gap:2px}
}


/* ============================================================
   年代刻度时间轴
   ============================================================ */
.tl{margin:34px 0 0}

.era{display:grid;grid-template-columns:6.6rem minmax(0,1fr);column-gap:clamp(14px,2.6vw,32px)}

.era__rail{position:relative;text-align:right;padding-top:2px;min-width:0}

.era__year{font-family:var(--mono);font-size:12.5px;color:var(--ink-2);letter-spacing:.01em;display:block;line-height:1.5}

.era__tag{font-family:var(--sans);font-size:11px;color:var(--ink-3);display:block;margin-top:3px;letter-spacing:.06em}

.era__rail::after{
  content:"";position:absolute;right:calc(-1 * clamp(14px,2.6vw,32px));top:.72em;
  width:clamp(14px,2.6vw,32px);height:1px;background:var(--rule)
}

.era__body{
  position:relative;border-left:1px solid var(--rule-2);
  padding:0 0 30px clamp(18px,2.8vw,38px);min-width:0
}

/* 脊线上的次刻度 */
.era__body::after{
  content:"";position:absolute;left:0;top:0;bottom:0;width:4px;pointer-events:none;
  background-image:repeating-linear-gradient(to bottom,var(--rule) 0 1px,transparent 1px 22px)
}

/* 主节点 */
.era__body::before{
  content:"";position:absolute;left:-5px;top:.55em;width:9px;height:9px;
  background:var(--paper);border:1.5px solid var(--v-accent);z-index:2
}

.era--major>.era__body::before{background:var(--v-accent)}

.era:last-child>.era__body{padding-bottom:6px}

.era h4{font-size:19px;margin:0 0 .35em;letter-spacing:0}

.era>.era__body>p{font-size:16px;color:var(--ink-2);max-width:58ch}
@media (max-width:719px){

  .era{grid-template-columns:minmax(0,1fr)}

  .era__rail{text-align:left;padding:0 0 6px 18px;display:flex;flex-wrap:wrap;gap:2px 12px;align-items:baseline}

  .era__rail::after{display:none}

  .era__year{font-size:12px}

  .era__tag{margin-top:0}

  .era__body{padding-left:18px}

  .era__rail{margin-left:0}
}


/* —— 分支组 —— */
.branch{display:grid;gap:var(--g);grid-template-columns:repeat(var(--n,2),minmax(0,1fr));margin:14px 0}

.strand{
  background:var(--panel);border:1px solid var(--rule);border-top:2px solid var(--sc,var(--rule-3));
  padding:13px 15px 14px;min-width:0
}

.strand h5{font-family:var(--sans);font-size:14.5px;margin:0 0 5px;line-height:1.45;color:var(--ink)}

.strand .yr{font-family:var(--mono);font-size:11.5px;color:var(--ink-3);display:block;margin:0 0 5px}

.strand p{font-size:14.5px;line-height:1.72;color:var(--ink-2);font-family:var(--sans);margin:0}

.strand p+p{margin-top:.5em}

.strand--inst{--sc:var(--f-inst)}

.strand--idea{--sc:var(--f-idea)}

.strand--tech{--sc:var(--f-tech)}

.strand--flow{--sc:var(--f-flow)}

.strand--key{--sc:var(--v-accent);background:var(--paper-2)}


/* —— 直角肘接连接线 —— */
.link{position:relative;display:grid;gap:var(--g);grid-template-columns:repeat(var(--n,2),minmax(0,1fr));height:26px;margin:0}

.link i{display:block;justify-self:center;width:1px;background:var(--rule-2);height:50%}

.link--down i{align-self:end}

.link--up i{align-self:start}

.link::before{
  content:"";position:absolute;top:50%;height:1px;background:var(--rule-2);
  left:calc((100% - (var(--n) - 1) * var(--g)) / var(--n) / 2);
  right:calc((100% - (var(--n) - 1) * var(--g)) / var(--n) / 2)
}

.link::after{content:"";position:absolute;left:50%;width:1px;background:var(--rule-2)}

.link--down::after{top:0;height:50%}

.link--up::after{top:50%;height:50%}

.link--plain{height:22px}

.link--plain i,.link--plain::before{display:none}

.link--plain::after{top:0;height:100%}
@media (max-width:719px){

  .branch{grid-template-columns:minmax(0,1fr)}

  .link{grid-template-columns:1fr;height:20px}

  .link i,.link::before{display:none}

  .link::after{top:0;height:100%}
}


/* —— 结论 / 判断标记（源文中的 ★） —— */
.claim{
  display:block;border-left:2px solid var(--v-accent);background:var(--v-accent-soft);
  padding:12px 16px 13px;margin:14px 0;font-size:15.5px;line-height:1.72
}

.claim::before{
  content:"判断";display:block;font-family:var(--sans);font-size:10.5px;
  letter-spacing:.16em;color:var(--v-accent);white-space:nowrap;margin:0 0 5px
}

.claim p{margin:0;color:var(--ink-2)}

.claim p+p{margin-top:.5em}

/* 宽屏改为侧栏标签：首列必须定宽，auto 会被最长段落撑爆 */
@media (min-width:720px){
  .claim{display:grid;grid-template-columns:2.7rem minmax(0,1fr);column-gap:14px;align-items:start}
  .claim::before{margin:0;padding-top:.42em}
  .claim p{grid-column:2}
}


/* —— 旁注（伊斯兰文明等横向影响） —— */
.aside-note{
  border:1px dashed var(--rule-2);background:transparent;padding:13px 16px;margin:14px 0;
  font-family:var(--sans);font-size:14.5px;line-height:1.72;color:var(--ink-2)
}

.aside-note b{font-family:var(--sans);font-weight:600;color:var(--ink);display:block;font-size:14px;margin-bottom:3px}


/* —— 争议概念可展开注释 —— */
details.dispute{border:1px solid var(--rule);background:var(--panel);margin:14px 0;max-width:64ch}

/* 块级 + 绝对定位标记：文字可自然换行，窄屏不会被挤成竖排 */
details.dispute>summary{
  cursor:pointer;list-style:none;position:relative;
  padding:11px 52px 11px 40px;font-family:var(--sans);font-size:14px;
  color:var(--ink-2);line-height:1.6
}

details.dispute>summary::-webkit-details-marker{display:none}

details.dispute>summary::before{
  content:"?";position:absolute;left:14px;top:12px;
  font-family:var(--mono);font-size:11px;width:17px;height:17px;
  border:1px solid var(--rule-3);color:var(--ink-3);display:grid;place-items:center;border-radius:50%
}

details.dispute>summary::after{
  content:"展开";position:absolute;right:14px;top:13px;
  font-size:11.5px;color:var(--ink-3);letter-spacing:.08em
}

details.dispute[open]>summary::after{content:"收起"}

details.dispute[open]>summary{border-bottom:1px solid var(--rule);color:var(--ink)}

details.dispute>summary:hover{background:var(--paper-2)}

.dispute__body{padding:13px 15px 15px;font-size:15px;line-height:1.78;color:var(--ink-2)}

.dispute__body p{margin:0 0 .7em}

.dispute__body p:last-child{margin:0}

.dispute__term{font-family:var(--mono);font-size:13px;color:var(--ink);border-bottom:1px dotted var(--rule-3);white-space:nowrap}


/* ============================================================
   12 个关键转折点
   ============================================================ */
.tps{margin:32px 0 0}

.tp{display:grid;grid-template-columns:4.6rem minmax(0,1fr);column-gap:clamp(12px,2.2vw,26px)}

.tp__n{
  font-family:var(--serif);font-size:clamp(26px,3.4vw,34px);line-height:1;color:var(--v-accent);
  text-align:right;padding-top:1px;font-variant-numeric:lining-nums;letter-spacing:0
}

.tp__yr{display:block;font-family:var(--mono);font-size:11px;color:var(--ink-3);margin-top:7px;line-height:1.45;letter-spacing:0}

.tp__b{
  position:relative;border-left:1px solid var(--rule-2);
  padding:0 0 26px clamp(18px,2.6vw,34px);min-width:0
}

.tp__b::before{content:"";position:absolute;left:-4px;top:.5em;width:7px;height:7px;background:var(--v-accent)}

.tp:last-child .tp__b{border-left-color:transparent;padding-bottom:4px}

.tp h4{font-size:19.5px;margin:0 0 .3em}

.tp>.tp__b>p{font-size:16px;color:var(--ink-2);max-width:58ch;margin:0 0 .6em}

.tp .cav{font-size:14.5px;color:var(--ink-3);font-family:var(--sans);line-height:1.7}


/* 前后变化链 */
.shift{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin:10px 0 12px !important;max-width:none !important}

.shift span{
  font-family:var(--sans);font-size:13.5px;line-height:1.5;padding:5px 11px;
  border:1px solid var(--rule-2);background:var(--panel);color:var(--ink-2);overflow-wrap:anywhere
}

.shift span:last-of-type{border-color:var(--v-accent);color:var(--ink);background:var(--paper-2)}

.shift b{font-family:var(--mono);font-size:14px;color:var(--rule-3);font-weight:400;flex:none}

.shift em{font-style:normal;font-family:var(--sans);font-size:11.5px;letter-spacing:.14em;color:var(--ink-3);flex:none;margin-right:2px}
@media (max-width:559px){

  .tp{grid-template-columns:3.1rem minmax(0,1fr)}

  .tp__n{font-size:24px}

  .tp__b{padding-left:14px}
}


/* ============================================================
   亚洲互动网络
   ============================================================ */
.netfig{margin:28px 0 6px;border:1px solid var(--rule);background:var(--panel);padding:8px 8px 4px;display:none}
@media (min-width:760px){
.netfig{display:block}
}

.netfig svg{display:block;width:100%;height:auto}

.netfig figcaption{font-family:var(--sans);font-size:12.5px;color:var(--ink-3);padding:8px 10px 8px;line-height:1.7;border-top:1px solid var(--rule);margin-top:4px}

.net-node{fill:var(--panel);stroke:var(--as-2);stroke-width:1.4}

.net-node--sea{stroke:var(--as-3)}

.net-label{font-family:"PingFang SC","Hiragino Sans GB",sans-serif;font-size:15px;fill:var(--ink)}

.net-sub{font-family:"PingFang SC","Hiragino Sans GB",sans-serif;font-size:12px;fill:var(--ink-3)}

.net-link{stroke:var(--rule-3);stroke-width:1.1;fill:none}

.net-link--sea{stroke:var(--as-3);stroke-dasharray:5 4;stroke-width:1.1}

.net-key{font-family:"PingFang SC","Hiragino Sans GB",sans-serif;font-size:12px;fill:var(--ink-3)}


/* ============================================================
   对照观察
   ============================================================ */
.cmp{margin:30px 0 0;border:1px solid var(--rule);background:var(--panel)}

.cmp__row{display:grid;grid-template-columns:9.5rem minmax(0,1fr) minmax(0,1fr)}

.cmp__row+.cmp__row{border-top:1px solid var(--rule)}

.cmp__row>*{padding:15px 18px;min-width:0}

.cmp__row>*+*{border-left:1px solid var(--rule)}

.cmp__head{background:var(--paper-2);font-family:var(--sans)}

.cmp__head>*{font-size:13px;letter-spacing:.1em;color:var(--ink-2)}

.cmp__head .eu{color:var(--eu-1);font-weight:600}

.cmp__head .as{color:var(--as-1);font-weight:600}

.cmp__k{font-family:var(--sans);font-size:13.5px;color:var(--ink-3);letter-spacing:.04em}

.cmp p{font-size:15px;line-height:1.75;color:var(--ink-2);font-family:var(--sans);margin:0}

.cmp .eu-c{box-shadow:inset 3px 0 0 -1px color-mix(in srgb,var(--eu-1) 55%,transparent)}

.cmp .as-c{box-shadow:inset 3px 0 0 -1px color-mix(in srgb,var(--as-1) 55%,transparent)}
@media (max-width:719px){

  .cmp__row{grid-template-columns:minmax(0,1fr)}

  .cmp__row>*+*{border-left:0;border-top:1px solid var(--rule)}

  .cmp__head{display:none}

  .cmp__k{background:var(--paper-2);font-weight:600;color:var(--ink);padding-top:12px;padding-bottom:12px}

  .cmp .eu-c::before{content:"欧洲";display:block;font-family:var(--sans);font-size:11px;letter-spacing:.14em;color:var(--eu-1);margin-bottom:5px}

  .cmp .as-c::before{content:"中国";display:block;font-family:var(--sans);font-size:11px;letter-spacing:.14em;color:var(--as-1);margin-bottom:5px}
}


/* ============================================================
   书单
   ============================================================ */
.shelf{display:grid;gap:var(--g);grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));margin:24px 0 0}

.bk{border:1px solid var(--rule);background:var(--panel);padding:18px 19px 20px;display:flex;flex-direction:column;min-width:0}

.bk__n{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--bc,var(--v-accent))}

.bk h4{font-size:18px;margin:7px 0 3px;line-height:1.4}

.bk .au{font-family:var(--sans);font-size:12.5px;color:var(--ink-3);margin:0 0 12px}

.bk dl{margin:0;display:grid;gap:9px}

.bk dt{font-family:var(--sans);font-size:11px;letter-spacing:.14em;color:var(--ink-3);margin-bottom:2px}

.bk dd{margin:0;font-family:var(--sans);font-size:14px;line-height:1.72;color:var(--ink-2)}

.bk dd.warn{color:var(--eu-2)}

.bk--one{background:var(--paper-2);border-color:var(--bc)}

.bk__badge{
  align-self:flex-start;margin-top:14px;font-family:var(--sans);font-size:11px;letter-spacing:.12em;
  color:var(--bc);border:1px solid var(--bc);padding:3px 8px
}

.pick{border-left:2px solid var(--v-accent);padding:13px 18px;margin:20px 0 0;font-size:15.5px;color:var(--ink-2);background:var(--v-accent-soft);max-width:70ch}


.order{display:grid;gap:var(--g);grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));margin:24px 0 0}

.ord{border:1px solid var(--rule);background:var(--panel);padding:16px 18px 18px;border-top:2px solid var(--oc)}

.ord h4{font-family:var(--sans);font-size:14px;letter-spacing:.08em;color:var(--oc);margin:0 0 12px}

.ord ol{margin:0;padding:0;list-style:none;counter-reset:o}

.ord li{
  counter-increment:o;position:relative;padding:0 0 14px 30px;font-family:var(--sans);font-size:14.5px;
  line-height:1.6;color:var(--ink-2)
}

.ord li::before{
  content:counter(o);position:absolute;left:0;top:1px;font-family:var(--mono);font-size:11px;
  width:19px;height:19px;border:1px solid var(--rule-2);display:grid;place-items:center;color:var(--ink-3);background:var(--paper)
}

.ord li::after{content:"";position:absolute;left:9px;top:21px;bottom:2px;width:1px;background:var(--rule)}

.ord li:last-child{padding-bottom:0}

.ord li:last-child::after{display:none}

.ord li b{display:block;color:var(--ink);font-weight:600}

.ord li span{font-size:13px;color:var(--ink-3)}

.ord--eu{--oc:var(--eu-1)}

.ord--as{--oc:var(--as-1)}

.ask{margin:22px 0 0;border:1px dashed var(--rule-2);padding:15px 18px;max-width:70ch}

.ask b{font-family:var(--sans);font-size:11.5px;letter-spacing:.14em;color:var(--ink-3);display:block;margin-bottom:8px}

.ask ol{margin:0;padding-left:1.3em;font-size:15.5px;color:var(--ink-2)}

.ask li{margin-bottom:3px}


/* ============================================================
   核校说明 / 参考来源
   ============================================================ */
.revs{display:grid;gap:var(--g);grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));margin:26px 0 0}

.rev{border:1px solid var(--rule);background:var(--panel);border-top:2px solid var(--rc);padding:18px 20px 20px}

.rev h4{font-family:var(--sans);font-size:14px;letter-spacing:.08em;color:var(--rc);margin:0 0 12px}

.rev ol{margin:0;padding-left:1.5em;font-size:14.8px;line-height:1.75;color:var(--ink-2);font-family:var(--sans)}

.rev li{margin-bottom:9px}

.rev li:last-child{margin-bottom:0}

.rev li b{color:var(--ink);font-weight:600}

.rev--eu{--rc:var(--eu-1)}

.rev--as{--rc:var(--as-1)}


.srcs{margin:24px 0 0;list-style:none;padding:0;display:grid;gap:0;border-top:1px solid var(--rule)}

.srcs li{border-bottom:1px solid var(--rule);padding:14px 0}

.srcs a{display:block;font-size:16px;line-height:1.55;color:var(--ink);text-decoration:none;font-family:var(--sans);font-weight:600}

.srcs a::after{content:"↗";font-size:12px;color:var(--ink-3);margin-left:7px;vertical-align:2px}

.srcs a:hover{color:var(--eu-1)}

.srcs a:hover::after{color:var(--eu-1)}

.srcs p{font-size:14.5px;color:var(--ink-3);margin:4px 0 0;font-family:var(--sans);line-height:1.7;max-width:76ch}

.srcs .host{font-family:var(--mono);font-size:11px;color:var(--rule-3);display:block;margin-top:5px;overflow-wrap:anywhere}


/* ============================================================
   页脚
   ============================================================ */
.foot{border-top:1px solid var(--rule);margin-top:60px;padding:34px 0 0}

.foot p{font-family:var(--sans);font-size:13.5px;color:var(--ink-3);line-height:1.8;max-width:70ch}

.totop{
  display:inline-block;margin-top:18px;font-family:var(--sans);font-size:12.5px;letter-spacing:.1em;
  color:var(--ink-2);text-decoration:none;border:1px solid var(--rule-2);padding:7px 14px
}

.totop:hover{border-color:var(--ink-2)}


/* ============================================================
   入场动效（JS 关闭或 reduced-motion 时内容默认完全可见）
   ============================================================ */
.visual-page.is-anim .reveal{opacity:0;transform:translateY(12px)}

.visual-page.is-anim .reveal.is-in{
  opacity:1;transform:none;
  transition:opacity .55s ease,transform .55s cubic-bezier(.2,.7,.2,1)
}

.visual-page.is-anim .era__body::before{transform:scale(.4);opacity:0}

.visual-page.is-anim .reveal.is-in .era__body::before,
.visual-page.is-anim .era.is-in>.era__body::before{transform:none;opacity:1;transition:transform .45s cubic-bezier(.2,.7,.2,1) .12s,opacity .3s ease .12s}

/* —— 转折点 → 大脉络 的互相定位 —— */
.era[id]{scroll-margin-top:80px}

.tp__jump{
  display:inline-block;margin-top:4px;font-family:var(--sans);font-size:12px;letter-spacing:.05em;
  color:var(--ink-3);text-decoration:none;border-bottom:1px solid var(--rule-2);padding-bottom:1px
}

.tp__jump:hover{color:var(--v-accent);border-bottom-color:var(--v-accent)}

.era[id]:target>.era__body{background:linear-gradient(90deg,var(--v-accent-soft),transparent 55%)}

/* ============================================================
   分区视图：头部、分节导航、页脚
   ============================================================ */
.viewhead{padding:clamp(26px,4.2vw,50px) 0 clamp(16px,2.2vw,24px)}

.viewhead .stage{margin:0 0 15px}

.viewhead .stage b{
  display:inline-block;font-family:var(--sans);font-weight:600;font-size:10.5px;
  letter-spacing:.16em;color:var(--vc,var(--ink-3));border:1px solid currentColor;padding:3px 9px
}

.viewhead h2{font-size:clamp(27px,4.6vw,42px);letter-spacing:0;margin:0 0 .34em;color:var(--vc,var(--ink))}

.viewhead>.wrap>p:last-child{font-size:clamp(15.5px,1.5vw,17.5px);color:var(--ink-2);max-width:58ch;margin:0;line-height:1.75}


.subnav{border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);background:var(--paper)}

.subnav .wrap{display:flex;align-items:center;gap:6px;flex-wrap:wrap;padding-top:8px;padding-bottom:8px}

.subnav__label{
  font-family:var(--sans);font-size:10.5px;letter-spacing:.16em;color:var(--vc,var(--ink-3));
  margin-right:8px;white-space:nowrap
}
@media (max-width:479px){
.subnav__label{display:none}
}

.subnav a{
  font-family:var(--sans);font-size:13px;text-decoration:none;color:var(--ink-3);
  padding:5px 11px;border:1px solid transparent;white-space:nowrap
}

.subnav a:hover{color:var(--ink);border-color:var(--rule)}

.subnav a[aria-current="true"]{color:var(--ink);border-color:var(--rule-2);background:var(--paper-2)}


.viewfoot{border-top:1px solid var(--rule);margin-top:clamp(40px,6vw,64px);padding:24px 0 0}

.viewfoot .wrap{display:flex;flex-wrap:wrap;gap:10px;align-items:center}

.vf-label{font-family:var(--sans);font-size:10.5px;letter-spacing:.16em;color:var(--ink-3);margin-right:4px;white-space:nowrap}

.vf-go{
  font-family:var(--sans);font-size:14px;text-decoration:none;color:var(--ink-2);
  border:1px solid var(--rule-2);padding:8px 15px;transition:border-color .16s ease,color .16s ease
}

.vf-go:hover{border-color:var(--ink-2);color:var(--ink)}

.vf-go--eu{color:var(--eu-1);border-color:color-mix(in srgb,var(--eu-1) 38%,var(--rule))}

.vf-go--as{color:var(--as-1);border-color:color-mix(in srgb,var(--as-1) 38%,var(--rule))}


/* ============================================================
   首屏的总分总结构图
   ============================================================ */
.mapstruct{max-width:820px;margin:20px 0 0}

.ms-tag{
  display:block;font-family:var(--sans);font-size:10.5px;letter-spacing:.18em;
  color:var(--ink-3);margin:0 0 9px
}

.ms-node{
  border:1px solid var(--rule);border-left:2px solid var(--v-accent);background:var(--panel);
  padding:13px 16px;font-family:var(--sans);font-size:15px;color:var(--ink);
  display:flex;align-items:baseline;gap:12px;flex-wrap:wrap
}

.ms-node em{
