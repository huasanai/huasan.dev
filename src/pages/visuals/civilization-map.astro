      if (bar) { page.style.setProperty('--partbar-h', Math.round(bar.getBoundingClientRect().height) + 'px'); }
    }

    function topOfPage() {
      var bar = page.querySelector('.partbar');
      var y = bar ? bar.getBoundingClientRect().top + window.pageYOffset : 0;
      var hdr = document.querySelector('.site-header');
      var off = hdr ? hdr.getBoundingClientRect().height : 0;
